# Copiar a .env (raíz, para forge) y a apps/web/.env.local (para Next).
# Sin las tres primeras la app corre igual: el motor, el dashboard y el storefront
# funcionan sin cadena, y el panel "Prove it on chain" dice qué falta.

# --- wallet del operador -----------------------------------------------------
# Índice 0 financia la campaña, registra agentes y liquida revenue.
# Cada agente deriva del índice N+1 de este mismo mnemónico.
DEPLOYER_MNEMONIC=""
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- red ---------------------------------------------------------------------
CHAIN_ID=133
RPC_URL=https://testnet.hsk.xyz
EXPLORER_URL=https://testnet-explorer.hskchain.net

# --- contratos (llenar después del deploy) -----------------------------------
TREASURY_ADDRESS=
TOKEN_ADDRESS=

# --- red publicitaria -------------------------------------------------------
# "mock" (por defecto) = simulador local: no depende de ninguna cuenta, saldo ni
# moderación externa. "adsterra" queda reservado para el adaptador futuro; hoy
# cualquier valor distinto de adsterra cae en el simulador.
AD_PLATFORM=mock

# Demo reproducible: fija la semilla de toda la corrida, así lo que se ensayó es
# exactamente lo que ve el jurado. "competition" es la buena para el pitch —
# un campeón que sube su presupuesto y cuatro que pausan su propia campaña.
# Los números igual salen de la simulación; la semilla solo evita la lotería.
DEMO_SCENARIO=competition
# Alternativa si prefieres una semilla cruda en vez de un escenario con nombre.
SIMULATION_SEED=

# --- pitches habladas (opcional) ---------------------------------------------
# Sin ningún proveedor configurado los agentes igual pitchean, pero con plantillas:
# no miran la foto. La demo nunca se queda muda.
#
# Qué modelo escribe los pitches. "anthropic" (por defecto) o "ollama".
# Vacío o con un typo cae en anthropic, para que un error de dedo no tumbe la demo.
AI_PROVIDER=anthropic

# --- proveedor: Anthropic ----------------------------------------------------
# Solo server-side. NUNCA prefijar con NEXT_PUBLIC_: llegaría al navegador.
ANTHROPIC_API_KEY=
# Opcional, para probar otro modelo sin tocar código.
ANTHROPIC_MODEL=

# --- proveedor: Ollama local -------------------------------------------------
# NO hace falta un modelo multimodal. La foto es un asset de la publicación, no
# entra al prompt: el agente decide con el texto del brief y su estrategia. Eso
# deja la inferencia en texto puro, que es lo que la hace viable en CPU.
#   ollama pull qwen2.5:3b        (o el modelo de texto que prefieras)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Un modelo local en CPU es lento; por defecto 120000 ms.
OLLAMA_TIMEOUT_MS=
# Guardia opcional: si hay menos de estos MB libres, no intenta llamar al modelo
# y lo dice de una, en vez de colgarse y caer a plantillas igual.
# Vacío o 0 = desactivada. En una máquina de 13 GB, 4000 es razonable.
OLLAMA_MIN_FREE_MB=

# --- opcionales --------------------------------------------------------------
# Quién cobra los pagos x402. Por defecto una dirección quemada.
AD_NETWORK_ADDRESS=
# Gas nativo que se le gotea a cada wallet nueva para que pueda firmar.
GAS_DRIP_ETHER=0.002

# --- cuentas y fondeo por usuario (opcional) ---------------------------------
# Sin estas tres la app corre como antes: una sola campaña compartida, sin login.
# Con ellas cada usuario tiene su propia campaña, sus agentes y su presupuesto, y
# firma el fondeo con su propia wallet.
#
# El App ID va al navegador a propósito (NEXT_PUBLIC_): identifica la app, no es
# un secreto. El App Secret es server-side y NUNCA debe llevar ese prefijo.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Opcional: pegar la verification key del dashboard de Privy evita una llamada a
# su API en cada request que verifica un token.
PRIVY_VERIFICATION_KEY=
